    family-names: Cerdeira
    affiliation: "London School of Hygiene & Tropical Medicine (LSHTM)"
    email: louise.cerdeira@gmail.com
    orcid: "https://orcid.org/0000-0002-4495-2615"
  - given-names: Sarah
    family-names: Scalercio
    affiliation: "Instituto de Ciência e Tecnologia em Biomodelos (ICTB), Fiocruz"
license: GPL-3.0-or-later

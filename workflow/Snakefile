# PanNosoVax — orquestração do pipeline completo
#
# Este Snakefile descreve o pipeline que EFETIVAMENTE roda. A versão anterior
# descrevia um caminho idealizado (bakta + panaroo + PSORTb + SignalP local) que
# nunca chegou a ser executado: essas ferramentas exigem bancos de dezenas de GB ou
# licença, e os resultados reais vieram de um caminho mais leve. Manter aquela
# descrição quebraria a reprodutibilidade e a seção de Métodos do manuscrito.
#
# Decisões de método que este arquivo reflete:
#   02  core genome por ortologia recíproca contra referência (BLASTp, O(N)) em vez
#       de pangenoma all-vs-all. Limitação assumida no docstring do script: genes
#       ausentes da referência não são descobertos.
#   03  localização por DeepLocPro (procariótico, roda local); SignalP-6 e DeepTMHMM
#       via BioLib rodam SÓ no subconjunto de superfície — a nuvem não aguenta o core
#       inteiro, e a localização já descarta ~94% das proteínas.
#   05  IEDB pelo runner próprio (o script canônico não bate com a API atual) e
#       conservação por k-mer exato sobre homólogos achados por BLAST — não exige
#       alinhamentos por gene, que este caminho não produz.
configfile: "config/config.yaml"

ORGANISMS = list(config["organisms"])
CLASSES = ["mhc1", "mhc2", "bcell"]
OUT = config["outdir"]

wildcard_constraints:
    org = "|".join(ORGANISMS),
    klass = "|".join(CLASSES)


rule all:
    input:
        f"{OUT}/08_construct/construct.fasta",
        f"{OUT}/09_physchem/construct_properties.tsv",
        f"{OUT}/12_expression/expression_summary.tsv",
        f"{OUT}/report/figures.done"


# ── 01 · aquisição ──────────────────────────────────────────────────────────────
rule fetch_genomes:
    output: f"{OUT}/01_genomes/{{org}}_selected.tsv"
    threads: 2
    shell:  "python scripts/01_fetch_genomes.py --organism {wildcards.org}"

rule download_proteomes:
    """Baixa os proteomas (.faa) dos genomas selecionados. O nº vem do config
    (organisms.<org>.n_genomes); idempotente — pula os já baixados."""
    input:  f"{OUT}/01_genomes/{{org}}_selected.tsv"
    output: directory(f"{OUT}/01_genomes/{{org}}_proteomes")
    shell:  "python scripts/01b_download_proteomes.py --organism {wildcards.org}"


# ── 02 · core genome ────────────────────────────────────────────────────────────
rule core_genome:
    input:  f"{OUT}/01_genomes/{{org}}_proteomes"
    output:
        core = f"{OUT}/02_pangenome/{{org}}_core_proteins.faa",
        pres = f"{OUT}/02_pangenome/{{org}}_presence.tsv"
    threads: config["threads"]
    shell:  "python scripts/02_core_genome_blast.py --organism {wildcards.org} --threads {threads}"


# ── 03 · surfaceome ─────────────────────────────────────────────────────────────
rule localization:
    """DeepLocPro: localização subcelular procariótica, local, no core inteiro."""
    input:  f"{OUT}/02_pangenome/{{org}}_core_proteins.faa"
    output: f"{OUT}/03_surfaceome/{{org}}_psortb.tsv"
    threads: config["threads"]
    shell:  "python scripts/run_surfaceome_tools.py --organism {wildcards.org} --tool deeploc"

rule signal_peptide:
    """SignalP-6 (BioLib) — só no subconjunto de superfície (ver surface_subset())."""
    input:  f"{OUT}/03_surfaceome/{{org}}_psortb.tsv"
    output: f"{OUT}/03_surfaceome/{{org}}_signalp.tsv"
    retries: 2
    shell:  "python scripts/run_surfaceome_tools.py --organism {wildcards.org} --tool signalp"

rule topology:
    """DeepTMHMM (BioLib) — idem, só no subconjunto de superfície."""
    input:  f"{OUT}/03_surfaceome/{{org}}_psortb.tsv"
    output: f"{OUT}/03_surfaceome/{{org}}_tmhmm.tsv"
    retries: 2
    shell:  "python scripts/run_surfaceome_tools.py --organism {wildcards.org} --tool tmhmm"

rule surfaceome:
    """Aplica os limiares do config: localização permitida por tipo de parede,
    peptídeo sinal, nº de hélices TM e faixa de tamanho."""
    input:
        psortb  = f"{OUT}/03_surfaceome/{{org}}_psortb.tsv",
        signalp = f"{OUT}/03_surfaceome/{{org}}_signalp.tsv",
        tmhmm   = f"{OUT}/03_surfaceome/{{org}}_tmhmm.tsv"
    output: f"{OUT}/03_surfaceome/{{org}}_candidates.tsv"
    shell:  "python scripts/03_surfaceome_filter.py --organism {wildcards.org}"


# ── 05 · epitopos + conservação ─────────────────────────────────────────────────
rule epitopes:
    """IEDB (B, MHC-I, MHC-II) pelo runner próprio: cache por proteína (retomável)
    e payload compatível com a API atual."""
    input:  expand(f"{OUT}/03_surfaceome/{{org}}_candidates.tsv", org=ORGANISMS)
    output: expand(OUT + "/05_epitopes/{org}_{klass}_raw.tsv", org=ORGANISMS, klass=CLASSES)
    retries: 2
    shell:  "python scripts/run_iedb_epitopes.py"

rule homologs:
    """Homólogos por BLASTp contra os proteomas de cada isolado — base da conservação."""
    input:
        cand = f"{OUT}/03_surfaceome/{{org}}_candidates.tsv",
        prot = f"{OUT}/01_genomes/{{org}}_proteomes"
    output: f"{OUT}/02_pangenome/{{org}}_homologs.json"
    threads: config["threads"]
    shell:  "python scripts/build_homologs_blast.py --organisms {wildcards.org} --threads {threads}"

rule conservation:
    """Conservação = fração dos isolados cujo homólogo contém o k-mer exato do epitopo."""
    input:
        raw = expand(OUT + "/05_epitopes/{org}_{klass}_raw.tsv", org=ORGANISMS, klass=CLASSES),
        hom = expand(f"{OUT}/02_pangenome/{{org}}_homologs.json", org=ORGANISMS)
    output: expand(OUT + "/05_epitopes/{org}_{klass}_conserved.tsv", org=ORGANISMS, klass=CLASSES)
    shell:  "python scripts/apply_conservation.py"


# ── 06-07 · segurança e cobertura ───────────────────────────────────────────────
rule safety:
    """Quatro camadas: self humano, mimetismo 7-mer, microbioma comensal e
    alergenicidade/toxicidade — esta última fica PENDENTE até submissão manual
    (AllerTOP/ToxinPred); ver docs/PROTOCOL.md §2A. Pendente não é aprovação."""
    input:  f"{OUT}/05_epitopes/{{org}}_{{klass}}_conserved.tsv"
    output: f"{OUT}/06_safety/{{org}}_{{klass}}_safe.tsv"
    threads: config["threads"]
    shell:  "python scripts/06_safety_screen.py --organism {wildcards.org} --class {wildcards.klass}"

rule coverage:
    """Cobertura máxima gulosa (garantia 1-1/e) ponderada por HLA mundial + brasileiro."""
    input:  expand(f"{OUT}/06_safety/{{org}}_{{{{klass}}}}_safe.tsv", org=ORGANISMS)
    output: f"{OUT}/07_coverage/selected_{{klass}}.tsv"
    wildcard_constraints:
        klass = "mhc1|mhc2"
    shell:  "python scripts/07_population_coverage.py --class {wildcards.klass} --n 18 --brazil-weight 0.5"


# ── 08-12 · construto e caracterização ──────────────────────────────────────────
rule construct:
    input:
        mhc  = expand(f"{OUT}/07_coverage/selected_{{k}}.tsv", k=["mhc1", "mhc2"]),
        bcel = expand(f"{OUT}/06_safety/{{org}}_bcell_safe.tsv", org=ORGANISMS)
    output:
        fasta = f"{OUT}/08_construct/construct.fasta",
        cmap  = f"{OUT}/08_construct/construct_map.tsv"
    shell:  "python scripts/08_construct_builder.py"

rule physchem:
    input:  f"{OUT}/08_construct/construct.fasta"
    output: f"{OUT}/09_physchem/construct_properties.tsv"
    shell:  "python scripts/09_physchem.py --fasta {input}"

rule expression:
    input:  f"{OUT}/08_construct/construct.fasta"
    output: f"{OUT}/12_expression/expression_summary.tsv"
    shell:  "python scripts/12_codon_optimize.py --fasta {input}"


# ── relatório ───────────────────────────────────────────────────────────────────
rule report:
    input:
        f"{OUT}/08_construct/construct_map.tsv",
        f"{OUT}/09_physchem/construct_properties.tsv",
        expand(f"{OUT}/07_coverage/selected_{{k}}.tsv", k=["mhc1", "mhc2"])
    output: touch(f"{OUT}/report/figures.done")
    shell:  "python scripts/report/paper_figures.py"


# ── etapas com dependência externa (fora do caminho padrão) ─────────────────────
# Rodam sob demanda: exigem ferramenta pesada, GPU ou submissão manual pelo navegador.
# Não entram em `rule all` para que o pipeline padrão termine sem intervenção humana.
#
#   estrutura 3D     scripts/10_structure.py                  ColabFold / Colab
#   docking          scripts/10b_docking.py                   HADDOCK
#   dinâmica (MD)    scripts/11_md_gromacs.sh                 GROMACS
#   imunossimulação  scripts/11b_immune_sim.py                C-ImmSim (web, manual)
#   dN/dS            scripts/04_conservation_dnds.py          HyPhy + CDS nucleotídicos
#   crossmatch       scripts/04b_structural_crossmatch_v2.py  TMalign + AlphaFold DB
rule structure:
    input:  f"{OUT}/08_construct/construct.fasta"
    output: f"{OUT}/10_structure/construct_refined.pdb"
    threads: config["threads"]
    shell:  "python scripts/10_structure.py --fasta {input} --out {output}"

rule immunosim:
    input:  f"{OUT}/08_construct/construct.fasta"
    output: f"{OUT}/11_immunosim/immune_response.tsv"
    shell:  "python scripts/11b_immune_sim.py --fasta {input}"

rule md:
    input:  f"{OUT}/10_structure/construct_refined.pdb"
    output: f"{OUT}/11_md/md_summary.tsv"
    threads: config["threads"]
    shell:  "bash scripts/11_md_gromacs.sh {threads}"
